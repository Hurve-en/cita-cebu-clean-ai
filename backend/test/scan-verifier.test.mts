import assert from 'node:assert/strict';
import {safeDecision,fingerprint,visionRequest} from '../workers/scan-verifier-core.mjs';
const valid={decision:'eligible',contains_waste:true,shows_disposal:true,challenge_matches:true,screen_or_print:false,unsafe:false,reason:'Evidence appears consistent with the disposal challenge'};
assert.equal(safeDecision(valid).decision,'eligible');
for(const change of [{contains_waste:false},{shows_disposal:false},{challenge_matches:false},{screen_or_print:true},{unsafe:true}])assert.equal(safeDecision({...valid,...change}).decision,'review');
assert.throws(()=>safeDecision({...valid,shows_disposal:'true'}));assert.throws(()=>safeDecision({...valid,decision:'guaranteed-real'}));
const bytes=Uint8Array.from([255,216,255,217]),pixels=new Uint8Array(9*8*4);for(let i=0;i<pixels.length;i++)pixels[i]=i%256;
const f=fingerprint(bytes,{width:9,height:8,data:pixels});assert.match(f.sha,/^[a-f0-9]{64}$/);assert.match(f.dhash,/^[a-f0-9]{16}$/);
assert.deepEqual(f,fingerprint(bytes,{width:9,height:8,data:pixels}));assert.throws(()=>fingerprint(new Uint8Array(3000000),{width:9,height:8,data:pixels}));
const request=visionRequest('vision-model-configured-by-operator',bytes,bytes,2);assert.equal(request.store,false);assert.equal(request.text.format.strict,true);assert.equal(request.input[0]?.content.length,3);assert.throws(()=>visionRequest('vision-model',bytes,bytes,7));
assert.match(JSON.stringify(visionRequest('vision-model',bytes,bytes,2,true)),/designated cleanup collection/);
console.log('PASS: verifier flags fail closed, deterministic fingerprints, image bounds, challenge and structured request checks; no external API was called');
const {safeSingleDecision,singleVisionRequest}=await import('../workers/scan-verifier-core.mjs');
const single={decision:'eligible',contains_waste:true,shows_disposal:true,screen_or_print:false,unsafe:false,quality_sufficient:true,reason:'Clear waste in an appropriate designated bin'};
assert.equal(safeSingleDecision(single).decision,'eligible');
for(const change of [{contains_waste:false},{shows_disposal:false},{screen_or_print:true},{unsafe:true},{quality_sufficient:false},{decision:'review'}])assert.equal(safeSingleDecision({...single,...change}).decision,'reject');
assert.throws(()=>safeSingleDecision({...single,quality_sufficient:'yes'}));
const singleRequest=singleVisionRequest('vision-test',bytes);assert.equal(singleRequest.input[0]?.content.length,2);assert.equal(singleRequest.store,false);assert.equal(singleRequest.text.format.strict,true);assert.match(JSON.stringify(singleRequest),/cannot establish its source/);
console.log('PASS: single-photo screening rejects ambiguous/unsafe/reproduced evidence without a manual fallback; no provider call was made');
